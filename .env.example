# fusion-cowork environment template — cp .env.example .env
# Conventions: architecture/fusion-db-conventions-1030.md (DB-2/DB-3/DB-4)
# Env-only config; no credentials in the repo.

# Shared PostgreSQL — ONE instance, one database per app (DB-2).
# The app creates its schema on connect (idempotent, DB-9); create the
# database once before first start:  createdb fusion_cowork
DATABASE_URL=postgresql://127.0.0.1:5432/fusion_cowork

# Shared Redis — single instance, per-app logical DB (DB-7).
# Reserved: fusion-cowork has no Redis dependency today; documented for
# the shared-instance convention so cache/pubsub adoption uses this path.
REDIS_URL=redis://127.0.0.1:6379/1
